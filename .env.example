# Lens Studio does not read .env files. This file documents the secret the Lens needs.
#
# REMOTE_SERVICE_GATEWAY_TOKEN
#   Generate in Lens Studio: Window > Remote Service Gateway Token > Generate Token.
#   Paste it into the RemoteServiceGatewayCredentials object in the Inspector.
#   Never commit a scene or prefab with the real token in it.
REMOTE_SERVICE_GATEWAY_TOKEN=
